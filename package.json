{
  "name": "eq-worker",
  "version": "3.9.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "description": "EQ-Worker 人情世故助手 - 人情账本、随礼参谋、话术参谋与关系经营",
  "scripts": {
    "build": "node build.js",
    "version:check": "node scripts/sync-version.mjs",
    "version:sync": "node scripts/sync-version.mjs --write && node build.js",
    "test:legacy": "node scripts/run-tests.mjs",
    "test:vite": "vitest run --config vitest.config.ts",
    "test": "node scripts/run-tests.mjs && vitest run --config vitest.config.ts",
    "verify:legacy": "node build.js && node scripts/run-tests.mjs",
    "verify:vite": "tsc --noEmit && vitest run --config vitest.config.ts && vite build --config vite.config.ts",
    "verify": "node scripts/sync-version.mjs && node build.js && node scripts/build-mini-core.mjs && node scripts/build-cli.mjs && node scripts/build-server.mjs && node scripts/build-mcp.mjs && node scripts/build-sdk.mjs && eslint . && tsc --noEmit && vitest run --config vitest.config.ts && vite build --config vite.config.ts && vite build --config vite.studio.config.ts && node scripts/run-tests.mjs",
    "build:mini-core": "node scripts/build-mini-core.mjs",
    "dev:vite": "vite --config vite.config.ts",
    "build:vite": "vite build --config vite.config.ts",
    "dev:studio": "vite dev --config vite.studio.config.ts",
    "build:studio": "vite build --config vite.studio.config.ts",
    "typecheck": "tsc --noEmit",
    "build:cli": "node scripts/build-cli.mjs",
    "build:server": "node scripts/build-server.mjs",
    "build:mcp": "node scripts/build-mcp.mjs",
    "build:all": "node scripts/build-cli.mjs && node scripts/build-server.mjs && node scripts/build-mcp.mjs",
    "start:server": "node dist-server/server.mjs",
    "lint": "eslint .",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "build:sdk": "node scripts/build-sdk.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "4.1.12",
    "esbuild": "0.25.12",
    "eslint": "^9.39.4",
    "happy-dom": "21.0.4",
    "playwright": "1.64.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "6.4.5",
    "vitest": "4.1.12",
    "zod": "4.6.7"
  },
  "bin": {
    "eqw": "dist-cli/eqw.mjs"
  }
}
