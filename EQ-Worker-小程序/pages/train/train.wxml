<view class="card" style="background:linear-gradient(135deg,#fffdf6,#eef3ec);text-align:center">
  <view style="width:150rpx;height:150rpx;border-radius:50%;background:#5f8575;color:#fff;display:flex;flex-direction:column;align-items:center;justify-content:center;margin:0 auto">
    <view style="font-size:44rpx;font-weight:700">{{w}}</view>
    <view style="font-size:20rpx">智慧值</view>
  </view>
  <view style="font-size:32rpx;font-weight:700;color:#5f8575;margin-top:14rpx">{{levelName}}</view>
  <view style="font-size:22rpx;color:#a89b88;margin-top:6rpx">{{nextText}}</view>
  <view style="height:14rpx;background:rgba(185,164,128,.22);border-radius:999rpx;overflow:hidden;margin-top:14rpx">
    <view style="height:100%;background:linear-gradient(90deg,#9cbfa8,#5f8575);width:{{pct}}%"></view>
  </view>
  <view style="font-size:22rpx;color:#a89b88;margin-top:10rpx">已连续修炼 {{streak}} 天{{trainedToday ? ' · 今日已练' : ' · 今日未练'}}</view>
</view>

<view class="card" wx:if="{{today}}" style="border-color:rgba(127,174,131,.45)">
  <view class="card-title">今日情景 · {{today.tag}} <text class="chip {{today.chip}}" style="float:right">{{today.diff}} ×{{today.w}}</text></view>
  <view style="font-size:30rpx;font-weight:600;margin:10rpx 0 4rpx">{{today.title}}</view>
  <view class="card-sub">{{today.scene}}</view>
  <button class="btn primary block" data-id="{{today.id}}" bindtap="open">开始应对 →</button>
</view>

<view style="display:flex;align-items:center;justify-content:space-between;padding:10rpx 20rpx">
  <view class="card-title">情景库</view>
  <text class="card-sub">每题满分 100，取最高分 · 难度越高智慧值加成越大</text>
</view>
<scroll-view class="chips-row" scroll-x style="white-space:nowrap;padding-bottom:10rpx">
  <view class="chip-sel {{diffIdx === index ? 'on' : ''}}" wx:for="{{diffKeys}}" wx:key="*this" data-i="{{index}}" bindtap="tapDiff">{{item}}</view>
</scroll-view>

<view wx:for="{{list}}" wx:key="id" class="card tap-fade" bindtap="open" data-id="{{item.id}}">
  <view style="display:flex;align-items:center;justify-content:space-between">
    <view style="font-size:28rpx;font-weight:600;flex:1">{{item.title}}</view>
    <text class="chip {{item.chip}}">{{item.diff}}</text>
  </view>
  <view class="card-sub">{{item.scene}}</view>
  <view class="card-sub" style="margin-top:8rpx">最高分：{{item.best ? item.best : '未挑战'}}</view>
</view>
